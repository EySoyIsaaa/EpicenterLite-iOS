# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# IDE and editors
.idea/
.vscode/
.codex/
.claude/settings.local.json
.gitconfig

# Dependencies
node_modules/
/.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Build output
/build
dist/
*.tsbuildinfo
.cache/

# Environment files and secrets
.env
*.env
*.env.*
!.env.example
*token.json*
*credentials.json*
*.pem
*.p12
*.pfx
*.mobileprovision
*.cer
*.key
*.jks
*.keystore
key.properties
GoogleService-Info.plist
google-services.json
.npmrc
.netrc
Secrets.xcconfig
*.private.xcconfig
id_rsa*

# Logs and debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dump.rdb

# System files
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
venv/
.venv/

# Archives and large binaries
**/*.zip
**/*.tar.gz
**/*.tar
**/*.tgz
*.pack
*.deb
*.dylib
*.jar

# iOS / Capacitor generated
ios/App/Pods/
ios/App/App/public/
ios/App/*.xcworkspace/xcuserdata/
ios/App/*.xcodeproj/xcuserdata/
**/xcuserdata/
*.xcuserstate
*.xcarchive
*.xcresult
*.ipa
*.dSYM/
*.dSYM.zip
DerivedData/

# Android generated
android/.gradle/
android/app/build/
android/build/
android/local.properties

# Epicenter lab: keep the source, ignore audio, binaries and rendered output
epicenter-lab/output/
epicenter-lab/*.exe
epicenter-lab/*.flac
epicenter-lab/*.mp3
epicenter-lab/*.wav
epicenter-lab/*.m4a
epicenter-lab/*.ogg

# Scratch / tooling leftovers
.emergent/
.manus-logs/
basura_para_borrar_manual/
epicenter audifonos/

# Deployment
.vercel
