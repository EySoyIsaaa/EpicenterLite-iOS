{
  "name": "epicenterdsp-lite-ios",
  "version": "1.0.0",
  "private": true,
  "description": "EpicenterDSP Lite para iOS con motor de audio nativo y biblioteca limitada a 30 canciones",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "check:test-types": "tsc -p tsconfig.test.json --noEmit",
    "verify:ios-plugin": "node scripts/verify-ios-native-plugin.mjs",
    "verify:release": "node scripts/verify-lite-release.mjs",
    "mac:setup": "bash scripts/mac-setup.sh"
  },
  "dependencies": {
    "@capacitor-community/admob": "6.2.0",
    "@capacitor/core": "6.2.1",
    "@capacitor/ios": "6.2.1",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "epicenter-native-ios": "file:plugins/epicenter-native-ios",
    "lucide-react": "^0.453.0",
    "next-themes": "^0.4.6",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "wouter": "3.7.1"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^24.7.0",
    "@types/react": "19.2.1",
    "@types/react-dom": "19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.14",
    "typescript": "5.9.3",
    "vite": "^7.1.9",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@10.4.1+sha512.c753b6c3ad7afa13af388fa6d808035a008e30ea9993f58c6663e2bc5ff21679aa834db094987129aa4d488b86df57f7b634981b2f827cdcacc698cc0cfb88af"
